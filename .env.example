# Wire in a real Neon Postgres instance by setting this. Run
# `npm run db:push` (or db:generate + a migration) once it's set — the
# Knowledge Hub schema needs the pgvector extension enabled on that database
# before document_chunks.embedding can be used:
#   CREATE EXTENSION IF NOT EXISTS vector;
DATABASE_URL=

# Google Cloud OAuth client (Google Cloud Console → APIs & Services →
# Credentials → OAuth client ID → Web application). Enable both the Google
# Drive API and the Google Sheets API on the project — one OAuth grant now
# covers Drive (Knowledge Hub) and Sheets (Supplier Records). Redirect URI
# must exactly match what's registered there, e.g.
# http://localhost:3000/api/google/callback in development or
# https://<your-domain>/api/google/callback in production.
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=
GOOGLE_REDIRECT_URI=

# Supplier Records (src/app/(app)/supplier-records) reads two tabs — "Items"
# and "Suppliers" — from this spreadsheet. Get the ID from the sheet's URL:
# https://docs.google.com/spreadsheets/d/<THIS_PART>/edit
# Only used as a fallback the first time Supplier Records syncs; after that
# the connected spreadsheet ID is stored against the integration itself.
GOOGLE_SHEETS_SUPPLIER_RECORDS_ID=
