# Wire in a real Neon Postgres instance by setting this. Run
# `npm run db:push` (or db:generate + a migration) once it's set — the
# Knowledge Hub schema needs the pgvector extension enabled on that database
# before document_chunks.embedding can be used:
#   CREATE EXTENSION IF NOT EXISTS vector;
DATABASE_URL=

# Google Cloud OAuth client (Google Cloud Console → APIs & Services →
# Credentials → OAuth client ID → Web application). Enable the Google Drive
# API on the project first. Redirect URI must exactly match what's registered
# there, e.g. http://localhost:3000/api/google/callback in development or
# https://<your-domain>/api/google/callback in production.
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=
GOOGLE_REDIRECT_URI=
